# =============================================================================
# CHAT-LANGCHAIN ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# LLM API KEYS
# =============================================================================

# OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fireworks API Key (optional, for Fireworks models)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# =============================================================================
# LANGSMITH CONFIGURATION (Optional - for tracing and monitoring)
# =============================================================================

# Enable LangSmith tracing
LANGCHAIN_TRACING_V2=true

# LangSmith API endpoint
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LangSmith API Key
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# LangSmith Project Name
LANGCHAIN_PROJECT=chat-langchain-project

# =============================================================================
# SUPABASE CONFIGURATION (Vector Database)
# =============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (not anon key!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# WEB SEARCH CONFIGURATION
# =============================================================================

# Tavily API Key (required for web search functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# RECORD MANAGER CONFIGURATION
# =============================================================================

# Database URL for SQLRecordManager (uses Supabase PostgreSQL)
RECORD_MANAGER_DB_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# =============================================================================
# EMBEDDING MODEL CONFIGURATION (Optional)
# =============================================================================

# Voyage AI API Key (if using Voyage embeddings)
VOYAGE_API_KEY=your_voyage_api_key_here

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. SUPABASE SETUP:
#    - Create a new Supabase project at https://supabase.com
#    - Enable the vector extension in SQL Editor: CREATE EXTENSION vector;
#    - Create embeddings table and matching function (see SUPABASE_MIGRATION_SUMMARY.md)
#    - Get your project URL and service role key from Settings > API
#
# 2. TAVILY SETUP:
#    - Sign up at https://tavily.com
#    - Get your API key from the dashboard
#    - Add it to TAVILY_API_KEY above
#
# 3. LLM PROVIDER SETUP:
#    - Get API keys from your chosen providers (OpenAI, Anthropic, etc.)
#    - Add them to the respective environment variables above
#
# 4. OPTIONAL - LANGSMITH SETUP:
#    - Sign up at https://smith.langchain.com
#    - Create a project and get your API key
#    - Add tracing configuration above
#
# =============================================================================